venv/
__pycache__/
*.pyc
.pytest_cache/
*.egg-info/
.env

# Every eval run is a real API-cost artifact — don't accumulate dozens of
# exploratory runs in git history. Commit specific reports intentionally
# (e.g. copy a good one to eval/results/final-report.md) rather than
# letting every run get tracked automatically.
eval/results/*.json
eval/results/report_*.md
eval/results/*_human_review.csv

.DS_Store
